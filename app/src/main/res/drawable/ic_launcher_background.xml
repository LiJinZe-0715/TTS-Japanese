<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive icon background: the same blue → purple the settings screen's hero card uses,
     so the launcher tile and the app itself read as one thing. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108">
                <item android:offset="0" android:color="#FF5566F5" />
                <item android:offset="0.52" android:color="#FF6E63F0" />
                <item android:offset="1" android:color="#FF9B6BFF" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
